{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "bench/data"]
}
