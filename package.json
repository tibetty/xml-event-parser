{
  "name": "xml-event-parser",
  "version": "0.1.0",
  "description": "Tiny dependency-free XML parser with a tree and path-based events in one pass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibetty/xml-event-parser.git"
  },
  "homepage": "https://github.com/tibetty/xml-event-parser#readme",
  "bugs": {
    "url": "https://github.com/tibetty/xml-event-parser/issues"
  },
  "keywords": [
    "xml",
    "parser",
    "events",
    "tree",
    "streaming",
    "zero-dependency"
  ],
  "main": "dist/index.cjs",
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:data": "node bench/generate.mjs",
    "bench": "node --expose-gc bench/run.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.12.1",
    "htmlparser2": "^12.0.0",
    "rolldown": "^1.3.2",
    "rolldown-plugin-dts": "^0.30.2",
    "sax": "^1.6.1",
    "txml": "^6.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
