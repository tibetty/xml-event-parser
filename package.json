{
  "name": "xml-event-parser",
  "version": "0.3.0",
  "description": "Streaming XML parser with path-based events: constant memory, zero dependencies, 4.8 KiB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibetty/xml-event-parser.git"
  },
  "homepage": "https://github.com/tibetty/xml-event-parser#readme",
  "bugs": {
    "url": "https://github.com/tibetty/xml-event-parser/issues"
  },
  "keywords": [
    "xml",
    "parser",
    "streaming",
    "sax",
    "event",
    "junit",
    "test-report",
    "sitemap",
    "gpx",
    "edge",
    "cloudflare-workers",
    "zero-dependency"
  ],
  "main": "dist/index.cjs",
  "scripts": {
    "build": "rolldown -c && node scripts/copy-dts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:data": "node bench/generate.mjs",
    "bench": "node --expose-gc bench/run.mjs",
    "bench:memory": "npm run build && node bench/memory.mjs",
    "prepublishOnly": "npm run build && npm run coverage && npm run check:package",
    "coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "conformance:data": "node scripts/fetch-xmlts.mjs"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "@types/sax": "^1.2.7",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-xml-parser": "^5.12.1",
    "htmlparser2": "^12.0.0",
    "publint": "^0.3.25",
    "rolldown": "^1.3.2",
    "rolldown-plugin-dts": "^0.30.2",
    "sax": "^1.6.1",
    "txml": "^6.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.mts",
        "default": "./dist/stream.mjs"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
